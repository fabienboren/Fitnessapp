# Copy to .env and fill in. Never commit .env or your private key.

PORT=8787
# Where the web app runs; used for CORS and post-login redirects.
WEB_ORIGIN=http://localhost:5173

# --- Kroger (https://developer.kroger.com) ---
# Create an app, enable the Products, Locations and Cart APIs.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your Kroger app.
# Goes through the Vite dev proxy so the session cookie stays same-origin.
KROGER_REDIRECT_URI=http://localhost:5173/api/kroger/callback
# Use https://api-ce.kroger.com for the certification (sandbox) environment.
KROGER_API_BASE=https://api.kroger.com

# --- Walmart Affiliate API (https://walmart.io) ---
# Consumer ID and key version from your walmart.io application.
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
# Path to the RSA private key whose public half you uploaded to walmart.io …
WALMART_PRIVATE_KEY_PATH=./walmart_private_key.pem
# … or the key itself (PEM, or the bare base64 body). Takes precedence over the path.
WALMART_PRIVATE_KEY=
# Optional: your Walmart affiliate publisher ID, for attribution.
WALMART_PUBLISHER_ID=
